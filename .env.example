# Copiá este archivo a .env solo en tu máquina. No subas valores reales.
# En Vercel se cargan en Project → Settings → Environment Variables.

# Token largo al azar. El bot lo manda como: Authorization: Bearer <API_TOKEN>
API_TOKEN=

# Del JSON de la cuenta de servicio (Firebase Console → Service accounts).
FIREBASE_PROJECT_ID=finanzas-personales-7b3ea
FIREBASE_CLIENT_EMAIL=
# PEM. Podés dejar los saltos como \n literales, igual que vienen en el JSON.
FIREBASE_PRIVATE_KEY=

# Solo para probar contra el emulador local. No la definas en Vercel.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
